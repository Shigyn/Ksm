<?xml version="1.0" encoding="UTF-8"?>
<!-- Une seule page : le site tient en une seule adresse, tout le
     reste est une ancre. Y lister #carte ou #venir n'ajouterait rien
     pour Google, qui ne les indexe pas separement.

     `lastmod` est ce qui dit a Google que la page a bouge et merite
     une nouvelle visite. A remettre a jour quand le contenu change
     vraiment — le renseigner a chaque deploiement sans changement
     reel apprend a Google a ne plus le croire. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://ksmburger.fr/</loc>
    <lastmod>2026-09-10</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
